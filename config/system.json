{
  "orchestration": {
    "max_concurrent": 2,
    "keep_alive": "0",
    "task_timeout_seconds": 300
  },
  "ollama": {
    "base_url": "http://localhost:11434",
    "retry_attempts": 3,
    "retry_delay_seconds": 2
  },
  "memory": {
    "max_errors_per_agent": 100,
    "max_skills_per_agent": 50,
    "training_sample_queue_limit": 500
  },
  "rag": {
    "chunk_size": 512,
    "chunk_overlap": 64,
    "top_k_results": 5
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s | %(levelname)s | %(name)s | %(message)s"
  }
}
